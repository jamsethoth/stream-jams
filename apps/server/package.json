{
  "name": "@stream-jams/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./runtime-profile": {
      "types": "./dist/config/runtime-profile.d.ts",
      "default": "./dist/config/runtime-profile.js"
    },
    "./runtime": {
      "types": "./dist/runtime/start-local-runtime.d.ts",
      "default": "./dist/runtime/start-local-runtime.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/require-profile.mjs && tsx watch src/index.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.7",
    "@napi-rs/keyring": "2.1.2",
    "@stream-jams/core": "workspace:0.0.0",
    "fastify": "5.12.8",
    "fresh": "0.5.2",
    "music-metadata": "12.3.5",
    "range-parser": "1.3.0",
    "sharp": "0.35.5",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@stream-jams/test-support": "workspace:0.0.0",
    "@types/fresh": "0.5.3",
    "@types/range-parser": "1.2.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
