    "@napi-rs/keyring": "1.3.0",
    "@stream-jams/core": "workspace:0.0.0",
    "fastify": "5.8.5",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@stream-jams/test-support": "workspace:0.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
