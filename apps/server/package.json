{
  "name": "@stream-jams/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./runtime": {
      "types": "./dist/runtime/start-local-runtime.d.ts",
      "default": "./dist/runtime/start-local-runtime.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@fastify/websocket": "11.3.1",
    "@napi-rs/keyring": "2.1.0",
    "@stream-jams/core": "workspace:0.0.0",
    "fastify": "5.12.5",
    "music-metadata": "11.15.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@stream-jams/test-support": "workspace:0.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
