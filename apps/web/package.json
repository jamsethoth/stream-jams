{
  "name": "@stream-jams/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b tsconfig.json && vite build",
    "typecheck": "tsc -b tsconfig.json",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --url http://127.0.0.1:6006 --ci --failOnConsole",
    "test-storybook:ci": "start-server-and-test \"storybook dev --host 127.0.0.1 --port 6006 --ci\" http://127.0.0.1:6006 \"test-storybook --url http://127.0.0.1:6006 --ci --failOnConsole\""
  },
  "dependencies": {
    "@stream-jams/core": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@storybook/test-runner": "0.24.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "29.1.1",
    "start-server-and-test": "3.0.11",
    "storybook": "10.4.6",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
