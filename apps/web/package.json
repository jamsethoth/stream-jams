{
  "name": "@stream-jams/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b tsconfig.json && vite build && node ../../scripts/check-web-route-bundles.mjs && vite build --config vite.desktop-overlay.config.ts",
    "typecheck": "tsc -b tsconfig.json",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006",
    "build-storybook": "storybook build",
    "test-storybook": "node ../../scripts/test-storybook.mjs --url http://127.0.0.1:6006 --ci --failOnConsole --maxWorkers=1 --testTimeout=30000",
    "test-storybook:ci": "start-server-and-test \"storybook dev --host 127.0.0.1 --port 6006 --ci\" http://127.0.0.1:6006 \"node ../../scripts/test-storybook.mjs --url http://127.0.0.1:6006 --ci --failOnConsole --maxWorkers=1 --testTimeout=30000\""
  },
  "dependencies": {
    "@stream-jams/core": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@storybook/test-runner": "0.24.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "start-server-and-test": "3.0.12",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
