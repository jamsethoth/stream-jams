# Stream Jams local environment template.
# Copy to .env for local overrides. Do not commit real secrets.

# Runtime profile: production (default when unset), dev or test. `pnpm dev` and `pnpm start:local` require it.
STREAM_JAMS_PROFILE=
# Required for dev and test: absolute folder holding that profile's config, data, assets, backups and logs.
STREAM_JAMS_HOME=
# Optional path to the persisted Stream Jams config JSON (defaults under the profile home).
STREAM_JAMS_CONFIG_PATH=
# Dev and test refuse to connect these Twitch account IDs (comma-separated; list the production account).
STREAM_JAMS_PROTECTED_TWITCH_ACCOUNT_IDS=
# Dev and test place the desktop overlay only on a display whose label contains this text (default: Parsec).
STREAM_JAMS_DEV_DISPLAY_LABEL=
# Portable dev OBS that automated OBS clients may change (defaults: C:\StreamJamsDev\obs, 4456).
STREAM_JAMS_DEV_OBS_ROOT=
STREAM_JAMS_DEV_OBS_PORT=
# Optional Twitch Client ID override for local account connection.
TWITCH_CLIENT_ID=
