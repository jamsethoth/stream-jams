{
  "name": "@stream-jams/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./csp-validation": {
      "types": "./dist/shared/csp-validation.d.ts",
      "default": "./dist/shared/csp-validation.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./event-bus": {
      "types": "./dist/event-bus/schemas.d.ts",
      "default": "./dist/event-bus/schemas.js"
    },
    "./music-style-policy": {
      "types": "./dist/music/style-policy.d.ts",
      "default": "./dist/music/style-policy.js"
    },
    "./videos": {
      "types": "./dist/videos/contract.d.ts",
      "default": "./dist/videos/contract.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "css-tree": "3.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "typescript": "6.0.3"
  }
}
