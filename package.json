{
  "name": "stream-jams",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "24.16.0",
    "pnpm": "11.2.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "desktop:package": "corepack pnpm build && node scripts/stage-desktop.mjs && corepack pnpm --filter @stream-jams/desktop package",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "dev": "corepack pnpm --parallel --filter @stream-jams/server --filter @stream-jams/web dev",
    "start:local": "corepack pnpm build && node apps/server/dist/index.js",
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm test:unit",
    "test:unit": "vitest run && node --test scripts/desktop-shutdown-fixture-data.test.mjs scripts/desktop-shutdown-exit.test.mjs",
    "test:e2e": "corepack pnpm --filter @stream-jams/core build && playwright test",
    "test:e2e:report": "playwright show-report",
    "playwright:docker-server": "node scripts/playwright-docker-server.mjs",
    "storybook": "corepack pnpm --filter @stream-jams/web storybook",
    "build-storybook": "corepack pnpm --filter @stream-jams/web build-storybook",
    "test:storybook": "corepack pnpm --filter @stream-jams/web test-storybook",
    "test:storybook:ci": "corepack pnpm --filter @stream-jams/web test-storybook:ci",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/ws": "8.18.1",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
