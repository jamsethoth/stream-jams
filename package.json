{
  "name": "stream-jams",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "24.16.0",
    "pnpm": "11.2.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @stream-jams/server --filter @stream-jams/web dev",
    "start:local": "corepack pnpm build && node apps/server/dist/index.js",
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "playwright:docker-server": "node scripts/playwright-docker-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "24.12.4",
    "@types/ws": "8.18.1",
    "eslint": "10.4.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vitest": "4.1.7"
  }
}
